{
  "name": "hasit-in",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "description": "Hasit.in unified Cloudflare Worker - all subdomains in one",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "dev:keys": "node scripts/dev-keys.js",
    "predev": "npm run check:config && npm run build:apps",
    "predeploy": "npm run check:config && npm run typecheck && npm run test && npm run build:apps",
    "deploy": "wrangler deploy",
    "deploy:dry": "npm run check:config && npm run build:apps && wrangler deploy --dry-run --outdir dist",
    "db:migrate": "node scripts/migrate.js",
    "db:migrate:local": "node scripts/migrate.js --local",
    "db:migrate:remote": "node scripts/migrate.js --remote",
    "check:config": "node scripts/check-config.js",
    "build:apps": "node scripts/build-apps.js",
    "pretypecheck": "npm run check:config",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "lint": "eslint src --ext .ts",
    "check": "npm run typecheck && npm run test && npm run deploy:dry"
  },
  "dependencies": {
    "hono": "^4.5.0",
    "jose": "^5.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261121.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.5.0",
    "wrangler": "4.166.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0"
  }
}
